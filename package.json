{
  "name": "pos-fastfood",
  "version": "1.5.2",
  "description": "KetaPOS — fastfood va kichik kafelar uchun kassa tizimi",
  "main": "electron/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "author": "POS",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "build": "vite build",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win",
    "deploy": "wrangler deploy",
    "preview": "wrangler dev",
    "brand": "node scripts/make-brand.mjs",
    "db:apply": "node scripts/apply-sql.mjs",
    "smoke:auth": "node scripts/smoke-auth.mjs",
    "smoke:pos": "node scripts/smoke-pos.mjs",
    "smoke:import": "node scripts/smoke-import.mjs",
    "smoke:photos": "node scripts/smoke-photos.mjs",
    "smoke:team": "node scripts/smoke-team.mjs",
    "smoke:offline": "node scripts/smoke-offline.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "lucide-react": "^1.70.0",
    "sql.js": "^1.15.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "vite": "^7.3.7",
    "wrangler": "^4.158.0"
  },
  "build": {
    "appId": "uz.pos.fastfood",
    "productName": "KetaPOS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/sql.js/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "KetaPOS"
    }
  }
}
